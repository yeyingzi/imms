*.credentials

# 本地配置文件
.env
.env.local
.env.*.local
config.local.js

# ===========================
# 后端敏感文件
# ===========================
# 实际配置文件（包含真实密码等敏感信息）
backend/src/main/resources/application.yml

# 本地配置文件
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-dev.yml
backend/src/main/resources/application-prod.yml

# Maven 本地仓库
backend/target/

# Gradle 构建文件（如果有）
# gradle/
# gradlew
# gradlew.bat

# ===========================
# 前端敏感文件
# ===========================
# Node modules
frontend/node_modules/

# 构建输出
frontend/dist/
frontend/.vite/

# IDE 配置（可选，建议保留以便团队协作）
# .idea/
# .vscode/settings.json

# ===========================
# 日志和临时文件
# ===========================
*.log
logs/
*.tmp
*.swp
*.swo
*~

# ===========================
# 系统文件
# ===========================
.DS_Store
Thumbs.db
desktop.ini

# ===========================
# 其他
# ===========================
*.bak
*.backup
*.old
*.orig

# 测试覆盖率报告
coverage/
*.lcov

# 编译文件
*.class
*.jar
*.war
*.ear

# Maven Wrapper（如果不需要）
# !mvnw
# !mvnw.cmd

# NPM Wrapper（如果不需要）

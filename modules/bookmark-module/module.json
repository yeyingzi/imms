{
  "moduleKey": "bookmark-module",
  "name": "网址收藏合集",
  "version": "1.1.0",
  "author": "Platform Team",
  "description": "共享网址收藏管理模块，支持搜索、隐私保护等功能",
  "icon": "Collection",
  "status": "enabled",
  "dependencies": [],
  "permissions": [
    {"code": "bookmark-module:view", "name": "查看网址收藏", "type": "menu"},
    {"code": "bookmark-module:create", "name": "添加网址", "type": "button"},
    {"code": "bookmark-module:edit", "name": "编辑网址", "type": "button"},
    {"code": "bookmark-module:delete", "name": "删除网址", "type": "button"}
  ],
  "menus": [
    {"name": "网址收藏", "icon": "Collection", "path": "/bookmark-module"}
  ],
  "endpoints": {
    "basePath": "/api/v1/bookmarks",
    "apis": [
      {"path": "", "method": "GET", "description": "获取网址列表（支持分页、搜索和筛选）"},
      {"path": "", "method": "POST", "description": "新增网址"},
      {"path": "/{id}", "method": "PUT", "description": "编辑网址（仅创建者）"},
      {"path": "/{id}", "method": "DELETE", "description": "删除网址（仅创建者）"},
      {"path": "/{id}/privacy", "method": "PUT", "description": "切换隐私状态（仅创建者）"}
    ]
  },
  "database": {
    "tables": ["bm_bookmark"],
    "autoInit": true
  }
}
